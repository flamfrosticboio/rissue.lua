local is_windows = package.config:sub(1, 1) == "\\"

-- a list of cmd required for tests in unix
---@type string[]
local has_cmd_unix = {
  "printenv",
}

---@return string
local function list_exclude_cmd()
  local res = {}

  if not is_windows then
    for _, cmd in ipairs(has_cmd_unix) do
      local check_ok = os.execute("command -v printenv >/dev/null 2>&1")
      if not check_ok then
        res[#res + 1] = "cmd:" .. cmd
      end
    end
  end

  return table.concat(res, ",")
end

local is_test_strict = os.getenv("TEST_STRICT") == "true"

--- Disable excludes if the test is strict (for cloud testing environments)
local exclude_cmd = is_test_strict and "" or list_exclude_cmd()

local excluded_tags = {
  "api",
}

if not is_test_strict then
  table.insert(excluded_tags, "blocking")
end

if not (os.getenv("INTERACTIVE") and os.getenv("INTERACTIVE") ~= "") then
  table.insert(excluded_tags, "interactive_only")
end

return {
  _all = {
    lpath = "./lua/?.lua;./lua/?/init.lua;./test/?.lua;./test/?/init.lua",
    ROOT = { "test" },
    ["exclude-tags"] = table.concat(excluded_tags, ",")
      .. ","
      .. (is_windows and "unix" or "windows")
      .. (exclude_cmd ~= "" and ("," .. exclude_cmd) or ""),
    helper = "test/helper.lua",
  },
  default = {
    verbose = true,
  },
  api = {
    tags = "api",
    ROOT = { "test/api" },
    verbose = true,
    ["exclude-tags"] = "",
    ["defer-print"] = true,
  },
  apiOne = {
    tags = "api",
    ["exclude-tags"] = "",
    ["defer-print"] = true,
    verbose = true,
  },
}
