{
    "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
    "runtime": {
        "version": "Lua 5.1"
    },
    "workspace": {
        "library": [
            "../lua/",
            "${3rd}/busted/library",
            "${3rd}/luassert/library",
            "${3rd}/luv/library"
        ]
    },
    "diagnostics": {
        "neededFileStatus": {
            "await-in-sync": "Any",
            "not-yieldable": "Any"
        }
    }
}
